// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// rank is a plain string enforced in application code (SQLite has no native
// enum support); valid values are the standard belt progression, see
// STUDENT_RANKS in shared/types.ts.
model Student {
  id              String            @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  rank            String?
  // When they started training here — distinct from createdAt (when this
  // record was entered) and from a membership plan's own billing start date.
  // Optional and backfilled manually, so there's no default.
  memberSince     DateTime?
  // Timestamp of when the Release and Indemnity Agreement checkbox was
  // agreed to at creation time — stamped by the server, not client-supplied,
  // so it reflects when the record actually says "yes", not something
  // editable after the fact. Null for students added before this existed.
  waiverAgreedAt  DateTime?
  street          String?
  city            String?
  state           String?
  zip             String?
  notes           String?
  // Deleting a student with lesson history violates the Lesson/RecurringSeries
  // foreign key, so "delete" falls back to archiving (active: false) instead —
  // this keeps them out of scheduling pickers while preserving history.
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lessons         Lesson[]
  recurringSeries RecurringSeries[]
  familyMembers   FamilyMember[]
  memberships     StudentMembership[]
}

// A named, ranked household member tracked alongside a primary Student record
// (e.g. for certificates), but not independently schedulable — lessons are
// always booked under the primary Student, never a FamilyMember directly.
model FamilyMember {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  rank      String?
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  @@index([studentId])
}

model Instructor {
  id              String            @id @default(cuid())
  firstName       String
  lastName        String
  email           String?
  phone           String?
  // Same archive-on-delete fallback as Student.active, see comment there.
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  lessons         Lesson[]
  recurringSeries RecurringSeries[]
}

// A weekly recurring lesson slot. Occurrences are materialized as ordinary
// Lesson rows (linked via Lesson.recurringSeriesId) on a rolling window,
// kept extended forward by extendAllActiveSeries() on app startup.
// Notes are intentionally not stored here: they're specific to a single
// lesson, not the series, so only the first generated occurrence gets the
// note entered at creation time and every later one starts blank.
model RecurringSeries {
  id             String      @id @default(cuid())
  // Group series have no student — see the "type" comment on Lesson below.
  student        Student?    @relation(fields: [studentId], references: [id])
  studentId      String?
  instructor     Instructor  @relation(fields: [instructorId], references: [id])
  instructorId   String
  // "private" | "group" — see Lesson.type.
  type           String      @default("private")
  // Group class name (e.g. "Cardio"); null for private series.
  title          String?
  dayOfWeek      Int
  startTime      String
  endTime        String
  active         Boolean     @default(true)
  generatedUntil DateTime
  createdAt      DateTime    @default(now())
  lessons        Lesson[]

  @@index([studentId])
  @@index([instructorId])
}

// One row per day of week (0 = Sunday ... 6 = Saturday), seeded lazily on first read.
model BusinessHours {
  id        String  @id @default(cuid())
  dayOfWeek Int     @unique
  isClosed  Boolean @default(false)
  openTime  String  @default("09:00")
  closeTime String  @default("20:00")
}

// Singleton row (always id 1) for app-level preferences that don't belong to
// any one domain model — seeded lazily on first read, same pattern as
// BusinessHours above.
model AppSettings {
  id                    Int       @id @default(1)
  autoBackupEnabled     Boolean   @default(false)
  // Absolute filesystem path chosen via a native directory picker. Backups
  // don't actually run until this is set, even if enabled is true.
  autoBackupDirectory   String?
  // "hourly" | "every_6_hours" | "daily" | "weekly" — see
  // AUTO_BACKUP_FREQUENCIES in shared/types.ts.
  autoBackupFrequency   String    @default("daily")
  // How many automatic backups to keep in the folder; older ones are deleted
  // after each successful backup. Null means keep every backup forever, which
  // is what the app did before this existed — an explicit choice rather than
  // an accident, since deleting backups is destructive and the user should be
  // able to opt out of it.
  autoBackupKeepCount   Int?      @default(30)
  // Timestamp of the last automatic backup that actually completed —
  // surfaced in Settings so the user has proof it's running, not just the
  // checkbox's word for it.
  lastAutoBackupAt      DateTime?
  // Message from the most recent automatic backup *attempt* that failed.
  // Cleared on the next success. Without this, a folder that stops resolving
  // (renamed, deleted, an unmounted network/sync path) fails silently to
  // console.error forever — Settings keeps showing the old success date and
  // the user's mental model stays "backups are on" long after they've stopped.
  lastAutoBackupError   String?
}

// SQLite has no native enum support in Prisma, so status is a plain string.
// Valid values are enforced in application code: "scheduled" | "completed" | "cancelled" | "no_show"
model Lesson {
  id                String           @id @default(cuid())
  // Group lessons have no assigned student — group classes have no
  // per-student roster in this app, they're just a block on an instructor's
  // schedule. Enforced in application code: "private" requires studentId
  // (and no title/prospect fields); "group" requires title (and no
  // studentId/prospect fields); "intro" requires prospectName (and no
  // studentId/title) — a free trial lesson for someone who isn't a Student
  // yet. No Student record is created for an intro booking; if they sign up
  // afterward, they're added as a normal student the usual way, same as
  // PosSale.studentName being a plain snapshot with no relation.
  student           Student?         @relation(fields: [studentId], references: [id])
  studentId         String?
  instructor        Instructor       @relation(fields: [instructorId], references: [id])
  instructorId      String
  // "private" | "group" | "intro"
  type              String           @default("private")
  // Group class name (e.g. "Cardio", "Shootfighting"); null for private/intro lessons.
  title             String?
  // Only set when type is "intro" — the prospect's name and (optionally) a
  // phone number for following up, not a Student relation.
  prospectName      String?
  prospectPhone     String?
  startTime         DateTime
  endTime           DateTime
  status            String           @default("scheduled")
  notes             String?
  recurringSeries   RecurringSeries? @relation(fields: [recurringSeriesId], references: [id])
  recurringSeriesId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([studentId])
  @@index([instructorId])
  @@index([startTime])
  @@index([recurringSeriesId])
}

// A billing plan the studio offers (e.g. "2 Private, Unlimited Group"). Group
// class access implied by the title isn't tracked — group classes have no
// per-student scheduling or roster in this app — so the title is
// descriptive/billing-only. Only the private-lesson allowance is actually
// tracked, since private lessons are ordinary Lesson rows.
model MembershipPlan {
  id                     String              @id @default(cuid())
  title                  String
  // "weekly" | "biweekly" | "monthly" — enforced in application code, see
  // MEMBERSHIP_BILLING_FREQUENCIES in shared/types.ts.
  billingFrequency       String              @default("monthly")
  priceCents             Int
  includedPrivateLessons Int                 @default(0)
  // Archived instead of deleted once a student is on it — same fallback as
  // Student.active/Instructor.active.
  active                 Boolean             @default(true)
  createdAt              DateTime            @default(now())
  studentMemberships     StudentMembership[]
}

// Links a Student to a MembershipPlan for one continuous stint of billing.
// Only one row per student should be active at a time (enforced in
// application code, not the schema) — if a student cancels and later
// rejoins, that's a new row rather than reusing the old one, so each stint's
// payments/usage history stays scoped to it.
model StudentMembership {
  id                 String                      @id @default(cuid())
  student            Student                     @relation(fields: [studentId], references: [id])
  studentId          String
  plan               MembershipPlan              @relation(fields: [planId], references: [id])
  planId             String
  // null = use billedPriceCents; set to record a custom deal.
  priceOverrideCents Int?
  // The plan's price and cadence as they were when this membership was created
  // (or last moved to a different plan). Billing math uses these, never the
  // plan's current values: the balance is recomputed from startDate on every
  // read, so reading live plan values meant editing a plan retroactively
  // rewrote every past period for everyone on it — raising a price invented
  // back-debt and flipped paid-up students to overdue. Plan edits therefore
  // apply to new sign-ups only; existing memberships keep what they were
  // signed up at until explicitly moved.
  billedPriceCents   Int
  billingFrequency   String
  // Deprecated: superseded by MembershipCharge below, which now records each
  // period's charge as its own row instead of a single running total. Kept
  // only because it's the sole surviving record of what was already charged
  // before that table existed — charges.ts reads it exactly once per
  // membership, the first time its charges are materialized, to fold that
  // history in as one "opening balance" row. Nothing writes to this field
  // anymore. Safe to drop in a later release once every real deployment has
  // had a chance to materialize at least once (dropping it sooner, before
  // that read has happened, would destroy the balance it's the last copy of).
  priorChargesCents  Int                         @default(0)
  startDate          DateTime
  // Set to false when the student is archived/deleted, or they cancel
  // outright — mirrors Student.active/Instructor.active.
  active             Boolean                     @default(true)
  createdAt          DateTime                    @default(now())
  payments           MembershipPayment[]
  usageAdjustments   MembershipUsageAdjustment[]
  charges            MembershipCharge[]

  @@index([studentId])
  @@index([planId])
}

// One row per billing period actually charged, at the price that applied when
// it was charged — the source of truth for what a membership owes, replacing
// the old priorChargesCents + "periods elapsed x current price" arithmetic.
// Rows are immutable once created: a later price or cadence change never
// rewrites an already-charged period, it only changes what future rows
// charge. Materialized lazily (see electron/ipc/memberships.ts) rather than
// on a schedule — a period only needs a row by the time someone reads the
// balance, same as the old formula only needed to be evaluated on read.
model MembershipCharge {
  id                  String            @id @default(cuid())
  studentMembership   StudentMembership @relation(fields: [studentMembershipId], references: [id])
  studentMembershipId String
  // Both null only for the one-time "opening balance" row created the first
  // time a pre-existing membership's charges are materialized under this
  // model — it folds in whatever priorChargesCents had already accumulated
  // before individual periods were tracked one at a time. That history's
  // original per-period breakdown was never kept (only ever a running total),
  // so it can't be reconstructed and is represented as a single dated line
  // instead. Every row created from this point forward has real bounds.
  periodStart         DateTime?
  periodEnd           DateTime?
  priceCents          Int
  createdAt           DateTime          @default(now())

  // Guards against ever double-charging the same period — the one invariant
  // that actually matters here. Doesn't constrain the opening-balance row
  // (periodStart is null there), but application code only ever creates one
  // of those per membership.
  @@unique([studentMembershipId, periodStart])
  @@index([studentMembershipId])
}

// Status is computed from a running balance (periods elapsed since the
// membership's startDate x price, minus the sum of all payments) — a
// payment is just an amount and a date, it doesn't need to describe which
// period(s) it covers.
model MembershipPayment {
  id                  String            @id @default(cuid())
  studentMembership   StudentMembership @relation(fields: [studentMembershipId], references: [id])
  studentMembershipId String
  amountCents         Int
  method              String?
  paidOn              DateTime
  notes               String?
  createdAt           DateTime          @default(now())

  @@index([studentMembershipId])
}

// A manual +/- correction to the live-computed "private lessons used this
// period" count (e.g. a bonus lesson) — additive on top of the computed
// count, never a raw overwrite, so it can't silently conflict with real
// scheduling activity.
model MembershipUsageAdjustment {
  id                  String            @id @default(cuid())
  studentMembership   StudentMembership @relation(fields: [studentMembershipId], references: [id])
  studentMembershipId String
  delta               Int
  reason              String?
  createdAt           DateTime          @default(now())

  @@index([studentMembershipId])
}

// A front-desk catalog item (merchandise, drop-in fees, etc.) — price only,
// no stock/inventory tracking. Archived instead of deleted once it's been
// sold at least once, same fallback as Student.active/Instructor.active.
model PosItem {
  id         String        @id @default(cuid())
  name       String
  priceCents Int
  active     Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  saleItems  PosSaleItem[]
}

// A completed front-desk checkout. studentName is a plain-text snapshot
// only — intentionally NOT a foreign key to Student, so deleting or
// renaming a student never mutates or orphans historical sales, and there's
// no relational "this student's purchase history" query. totalCents is
// computed server-side from the line items at creation time and stored as
// a historical fact, never trusted from the client and never recomputed.
model PosSale {
  id            String        @id @default(cuid())
  studentName   String?
  // "cash" | "card" | "check" | "other" — see POS_PAYMENT_METHODS in
  // shared/types.ts.
  paymentMethod String?
  totalCents    Int
  notes         String?
  createdAt     DateTime      @default(now())
  items         PosSaleItem[]
}

// One line of a sale. itemName/unitPriceCents snapshot the PosItem at sale
// time, so a later rename or price edit on the catalog item never changes
// a historical sale.
model PosSaleItem {
  id             String   @id @default(cuid())
  sale           PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId         String
  item           PosItem  @relation(fields: [itemId], references: [id])
  itemId         String
  itemName       String
  unitPriceCents Int
  quantity       Int
  createdAt      DateTime @default(now())

  @@index([saleId])
  @@index([itemId])
}
